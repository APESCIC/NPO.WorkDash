# NPO.WorkDash on Cloudron: template for /app/data/shared/.env
#
# Database and mail credentials are deliberately absent: the app reads the
# Cloudron addon variables (CLOUDRON_MYSQL_*, CLOUDRON_MAIL_SMTP_*,
# CLOUDRON_MAIL_FROM) and APP_URL falls back to CLOUDRON_APP_ORIGIN.
# See docs/security/secrets.md.

APP_NAME="NPO.WorkDash"
# staging on the staging app, production on the production app.
APP_ENV=production
# Generate once per app: php8.3 /app/data/workdash/artisan key:generate --show
# Back it up outside the server: losing it makes encrypted data unrecoverable.
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/London
APP_LOCALE=en_GB
APP_FALLBACK_LOCALE=en_GB
APP_FAKER_LOCALE=en_GB

# Send logs to Cloudron's log viewer instead of growing files in storage/logs.
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_FROM_NAME="${APP_NAME}"

# NPO.WorkDash environment configuration
#
# Copy to .env for local development (Laragon). Never commit .env or real
# credentials. Production and staging secrets live in /app/data/.env on
# Cloudron, and CI secrets live in GitHub Actions secrets. See
# docs/security/secrets.md.
#
# Uncommented keys are the ones you normally set. Commented keys are optional
# overrides: their value shows the default used when the key is absent.
#
# On Cloudron, omit DB_* and MAIL_* host/credential keys: the app reads the
# MySQL addon's CLOUDRON_MYSQL_* and the sendmail addon's CLOUDRON_MAIL_SMTP_*
# variables automatically, and APP_URL falls back to CLOUDRON_APP_ORIGIN.

# --- Application -------------------------------------------------------------

APP_NAME="NPO.WorkDash"
# local | staging | production. Demo data is only seeded in local.
APP_ENV=local
# Generate with `php artisan key:generate`. Encrypts sessions, cookies and
# encrypted model casts. Rotating it needs APP_PREVIOUS_KEYS (see docs).
APP_KEY=
# Comma-separated list of old APP_KEY values still accepted for decryption.
# APP_PREVIOUS_KEYS=
# Must be false outside local development.
APP_DEBUG=true
APP_URL=http://npo-workdash.test
APP_TIMEZONE=Europe/London

APP_LOCALE=en_GB
APP_FALLBACK_LOCALE=en_GB
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- Authentication ----------------------------------------------------------

# AUTH_GUARD=web
# AUTH_PASSWORD_BROKER=users
# AUTH_MODEL=App\Models\User
# AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
# Seconds before the password confirmation prompt is shown again.
# AUTH_PASSWORD_TIMEOUT=10800

# --- Logging -----------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug
# LOG_DAILY_DAYS=14
# LOG_STDERR_FORMATTER=
# LOG_SYSLOG_FACILITY=LOG_USER
# LOG_SLACK_WEBHOOK_URL=
# LOG_SLACK_USERNAME="${APP_NAME}"
# LOG_SLACK_EMOJI=:boom:
# LOG_PAPERTRAIL_HANDLER=
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=

# --- Database (MySQL 8) ------------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=npo_workdash
DB_USERNAME=root
DB_PASSWORD=
# DB_URL=
# DB_SOCKET=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci
# Path to a CA certificate when MySQL requires TLS.
# MYSQL_ATTR_SSL_CA=
# Only used by the sqlite, pgsql and sqlsrv connections.
# DB_FOREIGN_KEYS=true
# DB_SSLMODE=prefer
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=false

# --- Sessions ----------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to a slug of APP_NAME followed by "-session".
# SESSION_COOKIE=
# Set to true in staging and production (HTTPS only).
# SESSION_SECURE_COOKIE=
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax
# SESSION_PARTITIONED_COOKIE=false
# SESSION_EXPIRE_ON_CLOSE=false
# SESSION_CONNECTION=
# SESSION_TABLE=sessions
# SESSION_STORE=

# --- Broadcasting, filesystem, queue and cache --------------------------------

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# QUEUE_FAILED_DRIVER=database-uuids
# DB_QUEUE_CONNECTION=
# DB_QUEUE_TABLE=jobs
# DB_QUEUE=default
# DB_QUEUE_RETRY_AFTER=90

CACHE_STORE=database
# CACHE_PREFIX=
# DB_CACHE_CONNECTION=
# DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=

# --- Memcached (unused unless CACHE_STORE=memcached) --------------------------

MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=
# MEMCACHED_PERSISTENT_ID=

# --- Redis (unused unless a cache, queue or session driver uses it) ----------

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_URL=
# REDIS_USERNAME=
# REDIS_CLUSTER=redis
# REDIS_PREFIX=
# REDIS_PERSISTENT=false
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_MAX_RETRIES=3
# REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
# REDIS_BACKOFF_BASE=100
# REDIS_BACKOFF_CAP=1000
# REDIS_CACHE_CONNECTION=cache
# REDIS_CACHE_LOCK_CONNECTION=default
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=90

# --- Mail --------------------------------------------------------------------

# Locally, mail goes to Laragon's Mailpit (UI at http://127.0.0.1:8025).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@npo-workdash.test"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_URL=
# MAIL_EHLO_DOMAIN=
# MAIL_LOG_CHANNEL=
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"

# --- Third-party services (secrets: never commit real values) ----------------

# POSTMARK_API_KEY=
# POSTMARK_MESSAGE_STREAM_ID=
# RESEND_API_KEY=
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=

# --- AWS / S3-compatible storage and queues (unused by default) --------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_URL=
# AWS_ENDPOINT=
# DYNAMODB_CACHE_TABLE=cache
# DYNAMODB_ENDPOINT=
# SQS_PREFIX=
# SQS_QUEUE=default
# SQS_SUFFIX=
# BEANSTALKD_QUEUE_HOST=localhost
# BEANSTALKD_QUEUE=default
# BEANSTALKD_QUEUE_RETRY_AFTER=90

# --- Frontend (exposed to the browser bundle: never put secrets here) --------

VITE_APP_NAME="${APP_NAME}"
